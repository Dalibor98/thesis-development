{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ServiceUrls": {
    "AuthAPI": "https://localhost:7002",
    "UserAPIBase": "https://localhost:7005",
    "CurriculumAPIBase": "https://localhost:7103"
  },
  "FileUpload": {
    "MaxFileSizeMB": {
      "PDF": 20,
      "PPTX": 30,
      "Video": 1024 // 1GB for videos (approximately 1 hour of HD video)
    },
    "AllowedExtensions": {
      "PDF": [ ".pdf" ],
      "PPTX": [ ".ppt", ".pptx" ],
      "Video": [ ".mp4", ".mov", ".avi", ".wmv" ]
    }
  }
}
