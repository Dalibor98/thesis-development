@model List<MTS.Web.Models.Curriculum.Quiz.StudentAnswerDto>
@{
    ViewData["Title"] = "Override Quiz Grades";
    var quiz = ViewBag.Quiz as MTS.Web.Models.Curriculum.Quiz.QuizDto;
    var attempt = ViewBag.Attempt as MTS.Web.Models.Curriculum.Quiz.StudentQuizAttemptDto;
    var questionResponses = ViewBag.QuestionResponses as List<MTS.Web.Models.Curriculum.Quiz.QuizQuestionWithOptionsDto>;
}

<div class="card shadow border-0 mt-4">
    <div class="card-header bg-warning text-dark py-3">
        <div class="row">
            <div class="col-12">
                <h2 class="text-center">Grade Override - @quiz.Title</h2>
                <div class="d-flex justify-content-between mt-2">
                    <p class="mb-0"><strong>Student:</strong> @attempt.StudentUniversityId</p>
                    <p class="mb-0"><strong>Current Score:</strong> @attempt.Score%</p>
                </div>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <div class="row mb-4">
            <div class="col-12">
                <div class="alert alert-warning">
                    <h5>Admin Grade Override Tool</h5>
                    <p>Use this form to override grades for each answer in this quiz attempt. Changes will automatically update the overall quiz score.</p>
                </div>
            </div>
        </div>

        <!-- Answer Grading Forms -->
        <div class="accordion" id="answersAccordion">
            @for (int i = 0; i < Model.Count; i++)
            {
                var answer = Model[i];
                var questionInfo = questionResponses.FirstOrDefault(q => q.Question.QuizQuestionCode == answer.QuizQuestionCode);

                if (questionInfo == null) continue;

                var question = questionInfo.Question;
                var options = questionInfo.Options;

                <div class="accordion-item mb-3">
                    <h2 class="accordion-header" id="heading-@i">
                        <button class="accordion-button @(i > 0 ? "collapsed" : "")" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@i" aria-expanded="@(i == 0 ? "true" : "false")" aria-controls="collapse-@i">
                            <div class="d-flex justify-content-between w-100 me-3">
                                <span>Question @(i + 1): @(question.QuestionText.Length > 50 ? question.QuestionText.Substring(0, 50) + "..." : question.QuestionText)</span>
                                <span class="badge @(answer.IsCorrect ? "bg-success" : "bg-danger")">
                                    @(answer.IsCorrect ? "Correct" : "Incorrect") (@answer.PointsEarned / @question.Points)
                                </span>
                            </div>
                        </button>
                    </h2>
                    <div id="collapse-@i" class="accordion-collapse collapse @(i == 0 ? "show" : "")" aria-labelledby="heading-@i" data-bs-parent="#answersAccordion">
                        <div class="accordion-body">
                            <div class="card">
                                <div class="card-header bg-light">
                                    <h5>Question</h5>
                                </div>
                                <div class="card-body">
                                    <p class="lead">@question.QuestionText</p>
                                    <p><strong>Points Possible:</strong> @question.Points</p>
                                </div>
                            </div>

                            <div class="card mt-3">
                                <div class="card-header bg-light">
                                    <h5>Student Response</h5>
                                </div>
                                <div class="card-body">
                                    @if (quiz.QuizType == "MultipleChoice")
                                    {
                                        <div class="list-group">
                                            @foreach (var option in options)
                                            {
                                                var isSelected = option.OptionCode == answer.SelectedOptionCode;
                                                var optionClass = "";

                                                if (isSelected && option.IsCorrect)
                                                {
                                                    optionClass = "list-group-item-success";
                                                }
                                                else if (isSelected && !option.IsCorrect)
                                                {
                                                    optionClass = "list-group-item-danger";
                                                }
                                                else if (!isSelected && option.IsCorrect)
                                                {
                                                    optionClass = "list-group-item-info";
                                                }

                                                <div class="list-group-item @optionClass">
                                                    <div class="d-flex align-items-center">
                                                        @if (isSelected)
                                                        {
                                                            <span class="me-2">✓</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="me-2">&nbsp;</span>
                                                        }
                                                        @option.OptionText
                                                        @if (option.IsCorrect)
                                                        {
                                                            <span class="ms-2 badge bg-success">Correct Answer</span>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else if (quiz.QuizType == "TextBased")
                                    {
                                        <div class="border p-3 rounded">
                                            <p>@answer.TextAnswer</p>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="card mt-3">
                                <div class="card-header bg-warning text-dark">
                                    <h5>Override Grade</h5>
                                </div>
                                <div class="card-body">
                                    <form asp-action="OverrideGrade" method="post">
                                        <input type="hidden" name="Id" value="@answer.Id" />

                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">Is Answer Correct?</label>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="IsCorrect" id="correct-@answer.Id" value="true" @(answer.IsCorrect ? "checked" : "") />
                                                    <label class="form-check-label" for="correct-@answer.Id">
                                                        Yes
                                                    </label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="IsCorrect" id="incorrect-@answer.Id" value="false" @(!answer.IsCorrect ? "checked" : "") />
                                                    <label class="form-check-label" for="incorrect-@answer.Id">
                                                        No
                                                    </label>
                                                </div>
                                            </div>

                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">Points Earned (out of @question.Points)</label>
                                                <input type="number" class="form-control" name="PointsEarned" min="0" max="@question.Points" value="@answer.PointsEarned" required />
                                            </div>
                                        </div>

                                        <div class="d-grid">
                                            <button type="submit" class="btn btn-warning">
                                                Update Grade
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="mt-4">
            <a asp-action="GradeOverride" class="btn btn-outline-primary">Back to Grade Override</a>
        </div>
    </div>
</div>