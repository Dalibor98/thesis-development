@model MTS.Web.Models.Admin.SystemMetricsViewModel
@{
    ViewData["Title"] = "System Metrics";
}

<div class="card shadow border-0 mt-4">
    <div class="card-header bg-primary text-white py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h1>System Metrics Dashboard</h1>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <div class="row mb-4">
            <div class="col-12">
                <div class="alert alert-info">
                    <h5>System Overview</h5>
                    <p>This dashboard displays key metrics about the university learning management system.</p>
                </div>
            </div>
        </div>

        <!-- Users Summary -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h4>User Statistics</h4>
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-md-4">
                                <div class="p-3 border rounded bg-light">
                                    <h3>@Model.TotalUserCount</h3>
                                    <p>Total Users</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 border rounded bg-light">
                                    <h3>@Model.StudentCount</h3>
                                    <p>Students</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 border rounded bg-light">
                                    <h3>@Model.ProfessorCount</h3>
                                    <p>Professors</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Course & Enrollment Summary -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-success text-white">
                        <h4>Course & Enrollment Statistics</h4>
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-md-6">
                                <div class="p-3 border rounded bg-light">
                                    <h3>@Model.CourseCount</h3>
                                    <p>Total Courses</p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 border rounded bg-light">
                                    <h3>@Model.ActiveEnrollmentCount</h3>
                                    <p>Active Enrollments</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Average Students Per Course -->
        @if (Model.CourseCount > 0)
        {
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header bg-info text-white">
                            <h4>Course Analytics</h4>
                        </div>
                        <div class="card-body">
                            <div class="row text-center">
                                <div class="col-md-6 mx-auto">
                                    <div class="p-3 border rounded bg-light">
                                        <h3>@Math.Round((double)Model.ActiveEnrollmentCount / Model.CourseCount, 2)</h3>
                                        <p>Average Students Per Course</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="mt-4">
            <a asp-action="Admin" class="btn btn-outline-primary">Back to Admin Dashboard</a>
        </div>
    </div>
</div>