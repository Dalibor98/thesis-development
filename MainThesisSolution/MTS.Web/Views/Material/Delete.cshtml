@model MTS.Web.Models.Curriculum.Material.MaterialDto

@{
    ViewData["Title"] = "Delete Material";
}

<div class="container">
    <div class="card shadow border-0 mt-4">
        <div class="card-header bg-danger bg-gradient ml-0 py-3">
            <div class="row">
                <div class="col-12 text-center">
                    <h2 class="text-white py-2">Delete Material</h2>
                </div>
            </div>
        </div>
        <div class="card-body p-4">
            <form method="post">
                <input type="hidden" asp-for="MaterialCode" />
                <div class="border p-3 mt-4">
                    <div class="row pb-2">
                        <h2 class="text-primary">Are you sure you want to delete this material?</h2>
                        <hr />
                    </div>
                    <div class="mb-3 row">
                        <label class="p-0">Title</label>
                        <input class="form-control" value="@Model.Title" disabled />
                    </div>
                    <div class="mb-3 row">
                        <label class="p-0">Description</label>
                        <textarea class="form-control" rows="4" disabled>@Model.Description</textarea>
                    </div>
                    <div class="mb-3 row">
                        <label class="p-0">Material Type</label>
                        <input class="form-control" value="@Model.MaterialType" disabled />
                    </div>
                    <div class="row">
                        <div class="col-6 col-md-3">
                            <button type="submit" class="btn btn-danger form-control">Delete</button>
                        </div>
                        <div class="col-6 col-md-3">
                            <a asp-controller="Course" asp-action="Details" asp-route-courseCode="@Model.CourseCode" class="btn btn-outline-secondary form-control">
                                Back to Course
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>