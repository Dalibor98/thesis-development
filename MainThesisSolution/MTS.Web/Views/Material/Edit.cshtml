@model MTS.Web.Models.Curriculum.Material.MaterialUpdateDto

@{
    ViewData["Title"] = "Edit Material";
}

<div class="container">
    <div class="card shadow border-0 mt-4">
        <div class="card-header bg-primary bg-gradient ml-0 py-3">
            <div class="row">
                <div class="col-12 text-center">
                    <h2 class="text-white py-2">Edit Material</h2>
                </div>
            </div>
        </div>
        <div class="card-body p-4">
            <form method="post" enctype="multipart/form-data">
                <input asp-for="CourseCode" hidden />
                <input asp-for="WeekCode" hidden />
                <input asp-for="MaterialCode" hidden />
                <input asp-for="FileUrl" hidden />
                <div class="border p-3 mt-4">
                    <div class="row pb-2">
                        <h2 class="text-primary">Update Material</h2>
                        <hr />
                    </div>
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="mb-3 row">
                        <label asp-for="Title" class="p-0"></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                    <div class="mb-3 row">
                        <label asp-for="Description" class="p-0"></label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    <div class="mb-3 row">
                        <label asp-for="MaterialType" class="p-0"></label>
                        <select asp-for="MaterialType" class="form-select" id="materialTypeSelect">
                            <option value="Text">Text</option>
                            <option value="PDF">PDF</option>
                            <option value="Video">Video</option>
                            <option value="Presentation">Presentation</option>
                        </select>
                        <span asp-validation-for="MaterialType" class="text-danger"></span>
                    </div>
                    <div class="mb-3 row" id="fileUploadDiv" style="display: none;">
                        <label for="file" class="p-0">Upload New File</label>
                        <input type="file" id="file" name="file" class="form-control" />
                        @if (!string.IsNullOrEmpty(Model.FileUrl) &&
                        (Model.MaterialType == "PDF" || Model.MaterialType == "Video" || Model.MaterialType == "Presentation"))
                        {
                            <div class="form-text mt-2">
                                <span>Current file: <a href="@Url.Action("Download", new { materialCode = Model.MaterialCode })" target="_blank">Download Current File</a></span><br />
                                <span class="text-muted">Upload a new file to replace the current one, or leave empty to keep the existing file</span>
                            </div>
                        }
                    </div>
                    <div class="row">
                        <div class="col-6 col-md-3">
                            <button type="submit" class="btn btn-primary form-control">Update</button>
                        </div>
                        <div class="col-6 col-md-3">
                            <a asp-controller="Course" asp-action="Details" asp-route-courseCode="@Model.CourseCode" class="btn btn-outline-secondary form-control">
                                Back to Course
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Handle material type changes
            $("#materialTypeSelect").change(function () {
                var selectedType = $(this).val();

                // Hide controls initially
                $("#fileUploadDiv").hide();

                // Show appropriate control based on selection
                if (selectedType === "PDF" || selectedType === "Video" || selectedType === "Presentation") {
                    $("#fileUploadDiv").show();
                }
            });

            // Trigger change event to initialize the view correctly
            $("#materialTypeSelect").trigger("change");
        });
    </script>
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}