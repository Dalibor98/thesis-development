@model MTS.Web.Models.Curriculum.Material.MaterialDto

@{
    ViewData["Title"] = "View Material";
}

<div class="container">
    <div class="card shadow border-0 mt-4">
        <div class="card-header bg-primary bg-gradient ml-0 py-3">
            <div class="row">
                <div class="col-12 text-center">
                    <h2 class="text-white py-2">@Model.Title</h2>
                </div>
            </div>
        </div>
        <div class="card-body p-4">
            <div class="row mb-3">
                <div class="col-12">
                    <h4>Description</h4>
                    <p class="text-muted">@Model.Description</p>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-12">
                    <h4>Material</h4>
                    @if (Model.MaterialType == "Text")
                    {
                        <div class="border p-3 rounded bg-light">
                            @Model.Description
                        </div>
                    }
                    else if (Model.MaterialType == "PDF")
                    {
                        <div class="mb-3">
                            <div class="ratio ratio-16x9 mb-3" style="height: 600px;">
                                <object data="@Model.FileUrl" type="application/pdf" width="100%" height="100%">
                                    <p>Unable to display PDF. <a href="/Material/Download?materialCode=@Model.MaterialCode">Download</a> instead.</p>
                                </object>
                            </div>
                            <!-- Direct URL construction for more reliable linking -->
                            <div class="row mb-4"></div>
                            <div class="row mb-4"></div>
                            <a href="/Material/Download?materialCode=@Model.MaterialCode" class="btn btn-primary">
                                <i class="bi bi-download"></i> Download PDF
                            </a>
                        </div>
                    }
                    else if (Model.MaterialType == "Video")
                    {
                        <div class="mb-3">
                            <div class="ratio ratio-16x9 mb-3">
                                <video controls>
                                    <source src="@Model.FileUrl" type="video/mp4">
                                    Your browser does not support the video tag.
                                </video>
                            </div>
                            <a asp-action="Download" asp-route-materialCode="@Model.MaterialCode" class="btn btn-primary">
                                <i class="bi bi-download"></i> Download Video
                            </a>
                        </div>
                    }
                    else if (Model.MaterialType == "Presentation")
                    {
                        <div class="mb-3">
                            <div class="mb-3">
                                <a asp-action="Download" asp-route-materialCode="@Model.MaterialCode" class="btn btn-primary">
                                    <i class="bi bi-download"></i> Download Presentation
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="row">
                <div class="col-6 col-md-3">
                    <a asp-controller="Course" asp-action="Details" asp-route-courseCode="@Model.CourseCode" class="btn btn-outline-secondary form-control">
                        Back to Course
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>