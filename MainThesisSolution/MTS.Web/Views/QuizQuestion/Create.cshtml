```cshtml
@using MTS.Web.Models.Curriculum.Quiz
@model QuizQuestionCreateDto
@{
    ViewData["Title"] = "Create Question";
    var quizType = ViewBag.QuizType as string ?? "MultipleChoice";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h2>Add Question to Quiz</h2>
            <p class="mb-0">Quiz: @ViewBag.QuizTitle</p>
        </div>
        <div class="card-body">
            <form method="post" asp-action="Create">
                <input type="hidden" asp-for="QuizCode" />

                <div class="mb-3">
                    <label asp-for="QuestionText" class="form-label">Question Text</label>
                    <textarea asp-for="QuestionText" class="form-control" rows="4" required></textarea>
                    <span asp-validation-for="QuestionText" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Points" class="form-label">Points</label>
                    <input asp-for="Points" type="number" min="1" max="100" class="form-control" required />
                    <span asp-validation-for="Points" class="text-danger"></span>
                </div>

                @if (quizType == "MultipleChoice")
                {
                    <div class="alert alert-info">
                        <p><strong>Note:</strong> You'll be able to add answer options after creating this question.</p>
                    </div>
                }
                else if (quizType == "TextBased")
                {
                    <div class="alert alert-info">
                        <p><strong>Note:</strong> This is a text-based question. Students will provide written responses that you'll need to grade manually.</p>
                    </div>
                }

                <div class="row mt-4">
                    <div class="col-6">
                        <a asp-controller="Quiz" asp-action="View" asp-route-quizCode="@Model.QuizCode" class="btn btn-outline-secondary w-100">
                            Cancel
                        </a>
                    </div>
                    <div class="col-6">
                        <button type="submit" class="btn btn-primary w-100">Create Question</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
```