```cshtml
@using MTS.Web.Models.Curriculum.Quiz
@model QuizQuestionDto
@{
    ViewData["Title"] = "Delete Question";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-danger text-white">
            <h2>Delete Question</h2>
            <p class="mb-0">Quiz: @ViewBag.QuizTitle</p>
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                <h4>Are you sure you want to delete this question?</h4>
                <p>This action will delete the question and all associated answer options and student responses. This cannot be undone.</p>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h5>Question Details</h5>
                </div>
                <div class="card-body">
                    <p><strong>Question Text:</strong> @Model.QuestionText</p>
                    <p><strong>Points:</strong> @Model.Points</p>
                    <p><strong>Question Type:</strong> @Model.QuestionType</p>
                </div>
            </div>

            <form method="post" asp-action="Delete" asp-route-questionCode="@Model.QuizQuestionCode">
                <div class="row mt-3">
                    <div class="col-6">
                        <a asp-controller="Quiz" asp-action="View" asp-route-quizCode="@Model.QuizCode" class="btn btn-outline-secondary w-100">
                            Cancel
                        </a>
                    </div>
                    <div class="col-6">
                        <button type="submit" class="btn btn-danger w-100">Delete Question</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>