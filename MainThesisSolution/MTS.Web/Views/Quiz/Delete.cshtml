@using MTS.Web.Models.Curriculum.Quiz
@model QuizDto
@{
    ViewData["Title"] = "Delete Quiz";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-danger text-white">
            <h2>Delete Quiz</h2>
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                <h4>Are you sure you want to delete this quiz?</h4>
                <p>This action will delete the quiz and all associated questions, answers, and student attempts. This cannot be undone.</p>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h5>Quiz Details</h5>
                </div>
                <div class="card-body">
                    <p><strong>Title:</strong> @Model.Title</p>
                    <p><strong>Quiz Type:</strong> @Model.QuizType</p>
                    <p><strong>Start Time:</strong> @Model.StartTime.ToString("MMMM dd, yyyy h:mm tt")</p>
                    <p><strong>End Time:</strong> @Model.EndTime.ToString("MMMM dd, yyyy h:mm tt")</p>
                    <p><strong>Time Limit:</strong> @Model.TimeLimit minutes</p>
                </div>
            </div>

            <form method="post" asp-action="Delete" asp-route-quizCode="@Model.QuizCode">
                <div class="row mt-3">
                    <div class="col-6">
                        <a asp-controller="Course" asp-action="Details" asp-route-courseCode="@Model.CourseCode" class="btn btn-outline-secondary w-100">
                            Cancel
                        </a>
                    </div>
                    <div class="col-6">
                        <button type="submit" class="btn btn-danger w-100">Delete Quiz</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>