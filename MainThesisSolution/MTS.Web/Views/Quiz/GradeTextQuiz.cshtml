@using MTS.Web.Models.Curriculum.Quiz
@model QuizDto
@{
    ViewData["Title"] = "Grade Text Quiz";
    var quiz = Model;
    var attempts = ViewBag.Attempts as List<StudentQuizAttemptDto> ?? new List<StudentQuizAttemptDto>();
    var ungradedAnswers = ViewBag.UngradedAnswers as List<StudentAnswerDto> ?? new List<StudentAnswerDto>();
    var questionDetails = ViewBag.QuestionDetails as Dictionary<string, QuizQuestionDto> ?? new Dictionary<string, QuizQuestionDto>();

    // Group answers by student/attempt
    var answersByAttempt = ungradedAnswers
        .GroupBy(a => a.AttemptCode)
        .ToDictionary(g => g.Key, g => g.ToList());
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h2>Grade Text Quiz: @quiz.Title</h2>
        </div>
        <div class="card-body">
            @if (!ungradedAnswers.Any())
            {
                <div class="alert alert-success">
                    <h4>All answers have been graded!</h4>
                    <p>There are no pending text responses to grade for this quiz.</p>
                </div>

                <a asp-action="View" asp-route-quizCode="@quiz.QuizCode" class="btn btn-primary">
                    Back to Quiz
                </a>
            }
            else
            {
                <div class="alert alert-info mb-4">
                    <h5>Grading Instructions</h5>
                    <p>Grade each student response one at a time. Use the navigation tabs to switch between students and the next/previous buttons to move between answers.</p>
                    <p><strong>Note:</strong> Only correct answers can be assigned points. Incorrect answers will automatically receive 0 points.</p>
                </div>

                <ul class="nav nav-tabs mb-4" id="studentTabs" role="tablist">
                    @{
                        var firstTab = true;
                    }
                    @foreach (var attemptPair in answersByAttempt)
                    {
                        var attemptCode = attemptPair.Key;
                        var attempt = attempts.FirstOrDefault(a => a.AttemptCode == attemptCode);

                        if (attempt != null)
                        {
                            <li class="nav-item" role="presentation">
                                <button class="nav-link @(firstTab ? "active" : "")"
                                        id="student-@attempt.StudentUniversityId-tab"
                                        data-bs-toggle="tab"
                                        data-bs-target="#student-@attempt.StudentUniversityId"
                                        type="button"
                                        role="tab"
                                        aria-controls="student-@attempt.StudentUniversityId"
                                        aria-selected="@(firstTab ? "true" : "false")">
                                    Student: @attempt.StudentUniversityId
                                </button>
                            </li>

                            firstTab = false;
                        }
                    }
                </ul>

                <div class="tab-content" id="studentTabsContent">
                    @{
                        firstTab = true;
                    }
                    @foreach (var attemptPair in answersByAttempt)
                    {
                        var attemptCode = attemptPair.Key;
                        var answers = attemptPair.Value;
                        var attempt = attempts.FirstOrDefault(a => a.AttemptCode == attemptCode);

                        if (attempt != null)
                        {
                            <div class="tab-pane fade @(firstTab ? "show active" : "")"
                                 id="student-@attempt.StudentUniversityId"
                                 role="tabpanel"
                                 aria-labelledby="student-@attempt.StudentUniversityId-tab">

                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h4>Student: @attempt.StudentUniversityId</h4>
                                    <p class="mb-0">Attempt started: @attempt.StartTime.ToString("MM/dd/yyyy h:mm tt")</p>
                                </div>

                                <div class="progress mb-4">
                                    <div id="progress-@attempt.StudentUniversityId" class="progress-bar" role="progressbar" style="width: 0%;"
                                         aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                                        0%
                                    </div>
                                </div>

                                @for (int i = 0; i < answers.Count; i++)
                                {
                                    var answer = answers[i];

                                    if (questionDetails.TryGetValue(answer.QuizQuestionCode, out var question))
                                    {
                                        <div id="answer-card-@attempt.StudentUniversityId-@i" class="answer-card"
                                             style="@(i == 0 ? "" : "display: none;")">
                                            <form method="post" asp-action="GradeAnswer" class="grading-form">
                                                <input type="hidden" name="Id" value="@answer.Id" />
                                                <!-- Add next index and student ID as hidden inputs -->
                                                <input type="hidden" name="NextIndex" value="@(i + 1)" />
                                                <input type="hidden" name="StudentId" value="@attempt.StudentUniversityId" />
                                                <input type="hidden" name="TotalAnswers" value="@answers.Count" />

                                                <div class="card mb-4">
                                                    <div class="card-header bg-light">
                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <h5 class="mb-0">Question @(i + 1) of @answers.Count</h5>
                                                            <span class="badge bg-primary">@question.Points points possible</span>
                                                        </div>
                                                    </div>
                                                    <div class="card-body">
                                                        <h5 class="card-title">@question.QuestionText</h5>

                                                        <div class="card mt-3 mb-4">
                                                            <div class="card-header bg-light">
                                                                <h6 class="mb-0">Student's Response</h6>
                                                            </div>
                                                            <div class="card-body">
                                                                <p>@answer.TextAnswer</p>
                                                            </div>
                                                        </div>

                                                        <div class="row">
                                                            <div class="col-md-6">
                                                                <div class="mb-3">
                                                                    <label class="form-label">Points Earned (max @question.Points):</label>
                                                                    <input type="number" class="form-control points-input" name="PointsEarned"
                                                                           min="0" max="@question.Points" required
                                                                           id="points-@answer.Id" />
                                                                </div>
                                                            </div>
                                                            <div class="col-md-6">
                                                                <div class="mb-3">
                                                                    <label class="form-label">Is Correct?</label>
                                                                    <div class="form-check">
                                                                        <input class="form-check-input" type="radio" name="IsCorrect"
                                                                               value="true" id="correct-@answer.Id"
                                                                               onchange="handleCorrectnessChange('@answer.Id', true, @question.Points)" />
                                                                        <label class="form-check-label" for="correct-@answer.Id">
                                                                            Correct
                                                                        </label>
                                                                    </div>
                                                                    <div class="form-check">
                                                                        <input class="form-check-input" type="radio" name="IsCorrect"
                                                                               value="false" id="incorrect-@answer.Id" checked
                                                                               onchange="handleCorrectnessChange('@answer.Id', false, @question.Points)" />
                                                                        <label class="form-check-label" for="incorrect-@answer.Id">
                                                                            Incorrect
                                                                        </label>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="card-footer">
                                                        <div class="d-flex justify-content-between">
                                                            <button type="button" class="btn btn-outline-secondary @(i == 0 ? "disabled" : "")"
                                                                    onclick="showAnswer('@attempt.StudentUniversityId', @(i-1), @answers.Count)">
                                                                <i class="bi bi-arrow-left"></i> Previous
                                                            </button>
                                                            <button type="submit" class="btn btn-success">
                                                                Grade and @(i == answers.Count - 1 ? "Finish" : "Continue")
                                                            </button>
                                                            <button type="button" class="btn btn-outline-primary @(i == answers.Count - 1 ? "disabled" : "")"
                                                                    onclick="showAnswer('@attempt.StudentUniversityId', @(i+1), @answers.Count)">
                                                                Next <i class="bi bi-arrow-right"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </form>
                                        </div>
                                    }
                                }
                            </div>

                            firstTab = false;
                        }
                    }
                </div>

                <div class="mt-4">
                    <a asp-action="View" asp-route-quizCode="@quiz.QuizCode" class="btn btn-outline-secondary">
                        Back to Quiz
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // A simple function to show a specific answer card
        function showAnswer(studentId, index, total) {
            // Hide all answer cards for this student
            document.querySelectorAll(`[id^="answer-card-${studentId}-"]`).forEach(card => {
                card.style.display = 'none';
            });

            // Show the requested answer card
            document.getElementById(`answer-card-${studentId}-${index}`).style.display = 'block';

            // Update progress bar
            const progressPercent = Math.round(((index + 1) / total) * 100);
            const progressBar = document.getElementById(`progress-${studentId}`);
            progressBar.style.width = `${progressPercent}%`;
            progressBar.setAttribute('aria-valuenow', progressPercent);
            progressBar.textContent = `${progressPercent}%`;
        }

        // Handle correctness change
        function handleCorrectnessChange(answerId, isCorrect, maxPoints) {
            const pointsInput = document.getElementById(`points-${answerId}`);

            if (!isCorrect) {
                // If incorrect, set points to 0 and disable
                pointsInput.value = 0;
                pointsInput.disabled = true;
            } else {
                // If correct, enable the input
                pointsInput.disabled = false;

                // If points are 0, set default to half of max
                if (parseInt(pointsInput.value) === 0) {
                    pointsInput.value = Math.ceil(maxPoints / 2);
                }
            }
        }

        // Initialize when page loads
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize all points inputs based on default "incorrect" radio selection
            document.querySelectorAll('.form-check-input[value="false"]:checked').forEach(radio => {
                const answerId = radio.id.replace('incorrect-', '');
                const pointsInput = document.getElementById(`points-${answerId}`);
                if (pointsInput) {
                    pointsInput.value = 0;
                    pointsInput.disabled = true;
                }
            });

            // Handle POST redirection with hash in URL
            if (window.location.hash.startsWith('#next-')) {
                const parts = window.location.hash.substring(6).split('-');
                if (parts.length === 3) {
                    const studentId = parts[0];
                    const nextIndex = parseInt(parts[1]);
                    const total = parseInt(parts[2]);

                    // Switch to appropriate tab
                    const tabEl = document.getElementById(`student-${studentId}-tab`);
                    if (tabEl) {
                        const tab = new bootstrap.Tab(tabEl);
                        tab.show();
                    }

                    // Show next answer
                    setTimeout(() => {
                        showAnswer(studentId, nextIndex, total);
                    }, 100);
                }
            }
        });
    </script>
}