```cshtml
@using MTS.Web.Models.Curriculum.Quiz
@model QuizDto
@{
    ViewData["Title"] = "Grade Text Quiz";
    var attempts = ViewBag.Attempts as List<StudentQuizAttemptDto> ?? new List<StudentQuizAttemptDto>();
    var ungradedAnswers = ViewBag.UngradedAnswers as List<StudentAnswerDto> ?? new List<StudentAnswerDto>();
    var questions = ViewBag.Questions as List<QuizQuestionDto> ?? new List<QuizQuestionDto>();

    // Group answers by student/attempt
    var answersByAttempt = ungradedAnswers
        .GroupBy(a => a.AttemptCode)
        .ToDictionary(g => g.Key, g => g.ToList());
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h2>Grade Text Quiz: @Model.Title</h2>
        </div>
        <div class="card-body">
            @if (!ungradedAnswers.Any())
            {
                <div class="alert alert-success">
                    <h4>All answers have been graded!</h4>
                    <p>There are no pending text responses to grade for this quiz.</p>
                </div>

                <a asp-action="View" asp-route-quizCode="@Model.QuizCode" class="btn btn-primary">
                    Back to Quiz
                </a>
            }
            else
            {
                <div class="alert alert-info mb-4">
                    <h5>Grading Instructions</h5>
                    <p>For each student response, provide a grade based on the points available for that question. You can also provide feedback to the student.</p>
                </div>

                <ul class="nav nav-tabs mb-4" id="studentTabs" role="tablist">
                    @{
                        var firstTab = true;
                    }
                    @foreach (var attemptPair in answersByAttempt)
                    {
                        var attemptCode = attemptPair.Key;
                        var attempt = attempts.FirstOrDefault(a => a.AttemptCode == attemptCode);

                        if (attempt != null)
                        {
                            <li class="nav-item" role="presentation">
                                <button class="nav-link @(firstTab ? "active" : "")"
                                        id="student-@attempt.StudentUniversityId-tab"
                                        data-bs-toggle="tab"
                                        data-bs-target="#student-@attempt.StudentUniversityId"
                                        type="button"
                                        role="tab"
                                        aria-controls="student-@attempt.StudentUniversityId"
                                        aria-selected="@(firstTab ? "true" : "false")">
                                    Student: @attempt.StudentUniversityId
                                </button>
                            </li>

                            firstTab = false;
                        }
                    }
                </ul>

                <div class="tab-content" id="studentTabsContent">
                    @{
                        firstTab = true;
                    }
                    @foreach (var attemptPair in answersByAttempt)
                    {
                        var attemptCode = attemptPair.Key;
                        var answers = attemptPair.Value;
                        var attempt = attempts.FirstOrDefault(a => a.AttemptCode == attemptCode);

                        if (attempt != null)
                        {
                            <div class="tab-pane fade @(firstTab ? "show active" : "")"
                                 id="student-@attempt.StudentUniversityId"
                                 role="tabpanel"
                                 aria-labelledby="student-@attempt.StudentUniversityId-tab">

                                <h4>Student: @attempt.StudentUniversityId</h4>
                                <p>Attempt started: @attempt.StartTime.ToString("MM/dd/yyyy h:mm tt")</p>

                                <form method="post" asp-action="GradeAnswers">
                                    <input type="hidden" name="AttemptCode" value="@attemptCode" />
                                    <input type="hidden" name="QuizCode" value="@Model.QuizCode" />

                                    @foreach (var answer in answers)
                                    {
                                        var question = questions.FirstOrDefault(q => q.QuizQuestionCode == answer.QuizQuestionCode);

                                        if (question != null)
                                        {
                                            <div class="card mb-4">
                                                <div class="card-header">
                                                    <h5>Question: @question.QuestionText</h5>
                                                    <p class="mb-0">Points available: @question.Points</p>
                                                </div>
                                                <div class="card-body">
                                                    <h6>Student's Response:</h6>
                                                    <div class="p-3 border rounded mb-3">
                                                        <p>@answer.TextAnswer</p>
                                                    </div>

                                                    <input type="hidden" name="Grades[@answer.Id].Id" value="@answer.Id" />

                                                    <div class="row">
                                                        <div class="col-md-4">
                                                            <div class="mb-3">
                                                                <label class="form-label">Points Earned (max @question.Points):</label>
                                                                <input type="number" class="form-control" name="Grades[@answer.Id].PointsEarned"
                                                                       min="0" max="@question.Points" required />
                                                            </div>
                                                        </div>
                                                        <div class="col-md-8">
                                                            <div class="mb-3">
                                                                <label class="form-label">Is Correct?</label>
                                                                <div class="form-check">
                                                                    <input class="form-check-input" type="radio" name="Grades[@answer.Id].IsCorrect" value="true" id="correct-@answer.Id" />
                                                                    <label class="form-check-label" for="correct-@answer.Id">
                                                                        Correct
                                                                    </label>
                                                                </div>
                                                                <div class="form-check">
                                                                    <input class="form-check-input" type="radio" name="Grades[@answer.Id].IsCorrect" value="false" id="incorrect-@answer.Id" checked />
                                                                    <label class="form-check-label" for="incorrect-@answer.Id">
                                                                        Incorrect
                                                                    </label>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="mb-3">
                                                        <label class="form-label">Feedback (optional):</label>
                                                        <textarea class="form-control" name="Grades[@answer.Id].Feedback" rows="3"></textarea>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }

                                    <div class="d-grid gap-2 d-md-flex justify-content-md-end mb-4">
                                        <button type="submit" class="btn btn-primary">Submit Grades</button>
                                    </div>
                                </form>
                            </div>

                            firstTab = false;
                        }
                    }
                </div>

                <div class="mt-4">
                    <a asp-action="View" asp-route-quizCode="@Model.QuizCode" class="btn btn-outline-secondary">
                        Back to Quiz
                    </a>
                </div>
            }
        </div>
    </div>
</div>
```