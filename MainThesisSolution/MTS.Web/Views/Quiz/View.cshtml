@using MTS.Web.Models.Curriculum.Quiz
@model QuizDto
@{
    ViewData["Title"] = Model.Title;
    var questions = ViewBag.Questions as List<QuizQuestionDto> ?? new List<QuizQuestionDto>();
    var isProfessor = User.IsInRole("PROFESSOR");
    var isQuizTime = DateTime.Now >= Model.StartTime && DateTime.Now <= Model.EndTime;
    var hasAttempted = ViewBag.HasAttempted != null && ViewBag.HasAttempted;
    var quizClosed = DateTime.Now > Model.EndTime;
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <div class="d-flex justify-content-between align-items-center">
                <h3>@Model.Title</h3>
                @if (isProfessor)
                {
                    <div>
                        <a asp-action="Edit" asp-route-quizCode="@Model.QuizCode" class="btn btn-sm btn-warning">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <a asp-action="Delete" asp-route-quizCode="@Model.QuizCode" class="btn btn-sm btn-danger">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                    </div>
                }
            </div>
        </div>
        <div class="card-body">
            @if (isProfessor && !questions.Any())
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <strong>Warning:</strong> This quiz doesn't have any questions yet. Students cannot take a quiz without questions.
                </div>
            }

            <div class="row mb-3">
                <div class="col-md-4">
                    <p><strong>Quiz Type:</strong> @Model.QuizType</p>
                </div>
                <div class="col-md-4">
                    <p><strong>Time Limit:</strong> @Model.TimeLimit minutes</p>
                </div>
                <div class="col-md-4">
                    <p>
                        <strong>Status:</strong>
                        @if (quizClosed)
                        {
                            <span class="badge bg-danger">Closed</span>
                        }
                        else if (isQuizTime)
                        {
                            <span class="badge bg-success">Open</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Upcoming</span>
                        }
                    </p>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <p><strong>Start Time:</strong> @Model.StartTime.ToString("MMMM dd, yyyy h:mm tt")</p>
                </div>
                <div class="col-md-6">
                    <p><strong>End Time:</strong> @Model.EndTime.ToString("MMMM dd, yyyy h:mm tt")</p>
                </div>
            </div>

            @if (isProfessor)
            {
                <!-- Question Management Section for professors -->
                <div class="card mb-4">
                    <div class="card-header bg-info text-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5>Questions</h5>
                            <a asp-controller="QuizQuestion" asp-action="Create" asp-route-quizCode="@Model.QuizCode"
                               class="btn @(questions.Any() ? "btn-sm btn-light" : "btn-light")">
                                <i class="bi bi-plus-circle"></i> @(questions.Any() ? "Add Question" : "Add Your First Question")
                            </a>
                        </div>
                    </div>
                    <div class="card-body">
                        @if (questions.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Question</th>
                                            <th>Points</th>
                                            <th>Type</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < questions.Count; i++)
                                        {
                                            var question = questions[i];
                                            <tr>
                                                <td>@(i + 1)</td>
                                                <td>@question.QuestionText</td>
                                                <td>@question.Points</td>
                                                <td>@question.QuestionType</td>
                                                <td>
                                                    <div class="btn-group" role="group">
                                                        <a asp-controller="QuizQuestion" asp-action="Edit"
                                                           asp-route-questionCode="@question.QuizQuestionCode"
                                                           class="btn btn-sm btn-warning">Edit</a>

                                                        @if (Model.QuizType == "MultipleChoice")
                                                        {
                                                            <a asp-controller="Answer" asp-action="Create"
                                                               asp-route-questionCode="@question.QuizQuestionCode"
                                                               class="btn btn-sm btn-info">Answers</a>
                                                        }

                                                        <a asp-controller="QuizQuestion" asp-action="Delete"
                                                           asp-route-questionCode="@question.QuizQuestionCode"
                                                           class="btn btn-sm btn-danger">Delete</a>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info text-center">
                                <i class="bi bi-exclamation-circle-fill me-2" style="font-size: 1.5rem;"></i>
                                <p class="mb-3">No questions have been added to this quiz yet. Students cannot take a quiz without questions.</p>
                                <a asp-controller="QuizQuestion" asp-action="Create" asp-route-quizCode="@Model.QuizCode"
                                   class="btn btn-primary">
                                    <i class="bi bi-plus-circle"></i> Add Your First Question
                                </a>
                            </div>
                        }
                    </div>
                </div>

                <!-- Student Attempts Section for professors -->
                @if (ViewBag.Attempts != null && ((List<StudentQuizAttemptDto>)ViewBag.Attempts).Any())
                {
                    <div class="card">
                        <div class="card-header bg-success text-white">
                            <h5>Student Attempts</h5>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Student ID</th>
                                            <th>Start Time</th>
                                            <th>End Time</th>
                                            <th>Score</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var attempt in (List<StudentQuizAttemptDto>)ViewBag.Attempts)
                                        {
                                            <tr>
                                                <td>@attempt.StudentUniversityId</td>
                                                <td>@attempt.StartTime.ToString("MM/dd/yyyy h:mm tt")</td>
                                                <td>@attempt.EndTime.ToString("MM/dd/yyyy h:mm tt")</td>
                                                <td>@attempt.Score%</td>
                                                <td>
                                                    <a asp-action="AttemptDetails" asp-route-attemptCode="@attempt.AttemptCode"
                                                       class="btn btn-sm btn-primary">View Details</a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <!-- Student view of the quiz -->
                <div class="card">
                    <div class="card-header bg-light">
                        <h5>Quiz Information</h5>
                    </div>
                    <div class="card-body">
                        @if (hasAttempted)
                        {
                            <div class="alert alert-info">
                                <h5>You have already taken this quiz</h5>
                                <p>Your attempt has been recorded.</p>

                                @if (ViewBag.AttemptScore != null)
                                {
                                    <p><strong>Your Score:</strong> @ViewBag.AttemptScore%</p>
                                }

                                <a asp-action="ReviewAttempt" asp-route-quizCode="@Model.QuizCode"
                                   class="btn btn-primary mt-2">Review Your Answers</a>
                            </div>
                        }
                        else if (quizClosed)
                        {
                            <div class="alert alert-warning">
                                <h5>This quiz is closed</h5>
                                <p>The quiz closed on @Model.EndTime.ToString("MMMM dd, yyyy h:mm tt"). You can no longer take this quiz.</p>
                            </div>
                        }
                        else if (isQuizTime)
                        {
                            <div class="alert alert-success">
                                <h5>This quiz is currently open</h5>
                                <p>You have @Model.TimeLimit minutes to complete this quiz once you start.</p>
                                <p>The quiz will close at @Model.EndTime.ToString("MMMM dd, yyyy h:mm tt").</p>

                                @if (!questions.Any())
                                {
                                    <div class="alert alert-warning">
                                        <p>This quiz is not available yet. Please check back later.</p>
                                    </div>
                                }
                                else
                                {
                                    <a asp-action="TakeQuiz" asp-route-quizCode="@Model.QuizCode"
                                       class="btn btn-success mt-2">Start Quiz</a>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <h5>This quiz is not yet open</h5>
                                <p>The quiz will open on @Model.StartTime.ToString("MMMM dd, yyyy h:mm tt").</p>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="row mt-3">
                <div class="col-md-6">
                    <a asp-controller="Course" asp-action="Details" asp-route-courseCode="@Model.CourseCode"
                       class="btn btn-outline-primary">
                        <i class="bi bi-arrow-left"></i> Back to Course
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>