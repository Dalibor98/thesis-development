@using MTS.Web.Models.Curriculum.Assignment
@model Dictionary<string, List<AssignmentDto>>
@{
    ViewData["Title"] = "My Assignments";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h2>My Assignments</h2>
        </div>
        <div class="card-body">
            @if (Model.Count == 0)
            {
                <div class="alert alert-info">
                    <p>You don't have any assignments yet. Enroll in courses to see assignments.</p>
                    <a asp-controller="Course" asp-action="Index" class="btn btn-primary">Browse Courses</a>
                </div>
            }
            else
            {
                <div class="accordion" id="accordionCourses">
                    @{
                        int courseIndex = 0;
                    }
                    @foreach (var courseAssignments in Model)
                    {
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="heading@(courseIndex)">
                                <button class="accordion-button @(courseIndex > 0 ? "collapsed" : "")" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#collapse@(courseIndex)"
                                        aria-expanded="@(courseIndex == 0 ? "true" : "false")" aria-controls="collapse@(courseIndex)">
                                    @courseAssignments.Key (@courseAssignments.Value.Count assignments)
                                </button>
                            </h2>
                            <div id="collapse@(courseIndex)" class="accordion-collapse collapse @(courseIndex == 0 ? "show" : "")"
                                 aria-labelledby="heading@(courseIndex)" data-bs-parent="#accordionCourses">
                                <div class="accordion-body">
                                    <div class="table-responsive">
                                        <table class="table table-hover">
                                            <thead>
                                                <tr>
                                                    <th>Title</th>
                                                    <th>Due Date</th>
                                                    <th>Status</th>
                                                    <th>Points</th>
                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var assignment in courseAssignments.Value.OrderBy(a => a.DueDate))
                                                {
                                                    var isOverdue = DateTime.Now > assignment.DueDate;
                                                    var statusClass = isOverdue ? "danger" : "success";
                                                    var status = isOverdue ? "Overdue" : "Open";

                                                    if (ViewBag.Submissions != null)
                                                    {
                                                        // Cast ViewBag.Submissions to an appropriate collection type
                                                        var submissions = ViewBag.Submissions as IEnumerable<StudentAssignmentAttemptDto>;
                                                        if (submissions != null)
                                                        {
                                                            var submission = submissions.FirstOrDefault(s => s.AssignmentCode == assignment.AssignmentCode);
                                                            if (submission != null)
                                                            {
                                                                statusClass = submission.SubmissionStatus == "Graded" ? "success" :
                                                                submission.SubmissionStatus == "Late" ? "warning" : "primary";
                                                                status = submission.SubmissionStatus;
                                                            }
                                                        }
                                                    }

                                                    <tr>
                                                        <td>@assignment.Title</td>
                                                        <td>@assignment.DueDate.ToString("MM/dd/yyyy h:mm tt")</td>
                                                        <td><span class="badge bg-@statusClass">@status</span></td>
                                                        <td>@assignment.MaxPoints pts</td>
                                                        <td>
                                                            <a asp-controller="Assignment" asp-action="View"
                                                               asp-route-assignmentCode="@assignment.AssignmentCode"
                                                               class="btn btn-sm btn-primary">
                                                                View
                                                            </a>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                        courseIndex++;
                    }
                </div>
            }
        </div>
    </div>
</div>