@using MTS.Web.Models.Curriculum.Quiz
@model AnswerCreateDto
@{
    ViewData["Title"] = "Add Answer Option";
    var questionText = ViewBag.QuestionText ?? "Question";
    var quizCode = ViewBag.QuizCode ?? "";
    var existingAnswers = ViewBag.ExistingAnswers as List<AnswerDto> ?? new List<AnswerDto>();
    var hasCorrectAnswer = existingAnswers.Any(a => a.IsCorrect);
}

<div class="card shadow border-0 mt-4">
    <div class="card-header bg-primary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white">Add Answer Option</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <div class="row">
            <div class="col-md-12">
                <!-- Show existing answers -->
                @if (existingAnswers.Any())
                {
                    <div class="card mb-4">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">Existing Answer Options</h5>
                        </div>
                        <div class="card-body">
                            <ul class="list-group">
                                @foreach (var answer in existingAnswers)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <div>
                                            @answer.OptionText
                                            @if (answer.IsCorrect)
                                            {
                                                <span class="badge bg-success ms-2">Correct</span>
                                            }
                                        </div>
                                        <div>
                                            <a asp-controller="Answer" asp-action="Edit"
                                               asp-route-answerCode="@answer.AnswerCode"
                                               class="btn btn-sm btn-warning me-1">
                                                Edit
                                            </a>
                                            <a asp-controller="Answer" asp-action="Delete"
                                               asp-route-answerCode="@answer.AnswerCode"
                                               class="btn btn-sm btn-danger">
                                                Delete
                                            </a>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                }

                <div class="alert alert-info">
                    <h5>Question:</h5>
                    <p>@questionText</p>
                </div>

                <form method="post">
                    <input asp-for="QuizQuestionCode" type="hidden" />

                    <div class="form-floating py-2 col-12">
                        <textarea asp-for="OptionText" class="form-control border-0 shadow" style="height:100px;"></textarea>
                        <label asp-for="OptionText" class="ms-2">Answer Text</label>
                        <span asp-validation-for="OptionText" class="text-danger"></span>
                    </div>

                    <div class="form-check py-2 col-12">
                        @if (hasCorrectAnswer)
                        {
                            <input asp-for="IsCorrect" class="form-check-input" type="checkbox" disabled />
                            <label asp-for="IsCorrect" class="form-check-label">Is Correct Answer</label>
                            <div class="text-info mt-1">
                                <small>
                                    <i class="bi bi-info-circle"></i>
                                    A correct answer option already exists. To mark this as correct instead,
                                    first edit the existing correct answer to unmark it.
                                </small>
                            </div>
                        }
                        else
                        {
                            <input asp-for="IsCorrect" class="form-check-input" type="checkbox" />
                            <label asp-for="IsCorrect" class="form-check-label">Is Correct Answer</label>
                        }
                    </div>

                    <div class="row pt-3">
                        <div class="col-6 col-md-3">
                            <a asp-controller="Quiz" asp-action="View" asp-route-quizCode="@quizCode" class="btn btn-outline-primary form-control">Back to Quiz</a>
                        </div>
                        <div class="col-6 col-md-3">
                            <button type="submit" class="btn btn-primary form-control">Add Answer</button>
                        </div>
                        @if (existingAnswers.Count >= 2)
                        {
                            <div class="col-12 col-md-6 mt-2 mt-md-0">
                                <a asp-controller="Quiz" asp-action="View" asp-route-quizCode="@quizCode" class="btn btn-success form-control">
                                    Finish Adding Answers
                                </a>
                            </div>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}