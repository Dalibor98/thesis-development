@using MTS.Web.Models.Curriculum.Quiz
@model AnswerOptionDto
@{
    ViewData["Title"] = "Delete Answer Option";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-danger text-white">
            <h2>Delete Answer Option</h2>
            <p class="mb-0">Question: @ViewBag.QuestionText</p>
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                <h4>Are you sure you want to delete this answer option?</h4>
                <p>This action cannot be undone.</p>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h5>Answer Details</h5>
                </div>
                <div class="card-body">
                    <p><strong>Answer Text:</strong> @Model.OptionText</p>
                    <p>
                        <strong>Correct Answer:</strong>
                        @if (Model.IsCorrect)
                        {
                            <span class="badge bg-success">Yes</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">No</span>
                        }
                    </p>
                </div>
            </div>

            <form method="post" asp-action="Delete" asp-route-id="@Model.Id" asp-route-quizCode="@ViewBag.QuizCode">
                <div class="row mt-3">
                    <div class="col-6">
                        <a asp-controller="Quiz" asp-action="View" asp-route-quizCode="@ViewBag.QuizCode" class="btn btn-outline-secondary w-100">
                            Cancel
                        </a>
                    </div>
                    <div class="col-6">
                        <button type="submit" class="btn btn-danger w-100">Delete Answer</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>